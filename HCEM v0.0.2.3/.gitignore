# 依赖
node_modules/
.pnpm-store/
.pnpm-debug.log

# 构建产物
dist/
build/
out/
coverage/
*.tsbuildinfo

# 运行数据（HCEM 私有数据：情绪、记忆、人设、日志、人物网）
# data/ 下除 reincarnation 的说明文件外全部排除：
# 这样「前世记忆」目录能随仓库分发指路，但用户放进去的记忆文件不会被提交。
data/*
!data/reincarnation/
data/reincarnation/*
!data/reincarnation/README.md
_trash-*/
*.sqlite
*.sqlite-wal
*.sqlite-shm
emotion-samples.json

# 日志与临时文件
*.log
npm-debug.log*
*.tmp
*.bak

# 环境变量与密钥
.env
.env.*
!.env.example
*.pem
*.key

# 编辑器与系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
