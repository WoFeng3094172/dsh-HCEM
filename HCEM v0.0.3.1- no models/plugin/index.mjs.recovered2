  // 4a) 记忆 pin 工具（AI 配额：缓冲池 2 次��生�?知识�?2 次，分开计）
  let aiPinQuotaPool = 2
  let aiPinQuotaLong = 2
  defineTool({
    name: 'hcem_memory_pin',
    description:
      '调整记忆重要度（pinned）：direction=up �?0.5，down �?0.5（pinned 范围 0~2，缓冲池 0~1）��? +
      '缓冲池配�?2 次��生�?知识区配�?2 次（分开计，不能跨区使用）��? +
      '用户明确要求记住或你确信重要�?up；你判断某条已不重要/过时时可�?down（可抵消用户或自己的判断）��? +
      '任务类工作请�?hcem_work(action=write)，不要重�?pin�?,
    parameters: {
      type: 'object',
      additionalProperties: false,
      properties: {
        id: { type: 'string', description: '记忆 id' },
        direction: { type: 'string', enum: ['up', 'down'], description: 'up=�?0.5，down=�?0.5；默�?up' },
      },
      required: ['id'],
    },
    output: {
      schema: {
        type: 'object',
        additionalProperties: false,
        properties: {
          ok: { type: 'boolean' },
          id: { type: 'string' },
          pinned: { type: 'number' },
          error: { type: 'string' },
        },
        required: ['ok'],
      },
      render: (_args, value) =>
        value.ok
          ? [{ type: 'text', text: `已调整��?{value.id}」pinned=${value.pinned}（缓冲池剩余 ${aiPinQuotaPool} �?/ 生活知识区剩�?${aiPinQuotaLong} 次）` }]
          : [{ type: 'text', text: `pin 失败�?{value.error}` }],
    },
    execute: async ({ id, direction = 'up' }) => {
        // 会话门禁：只�?HCEM 模式的会话才能调�?
        if (!isHcemSession(currentAgent()?.session)) {
          throw new Error('�?HCEM 会话，禁止调用此工具')
        }
      const m = store ? store.getMemory(id) : null
      if (!m) return { ok: false, id, error: 'not-found' }
      const isPool = ['context', 'pool_fast', 'pool_observe', 'pool_keep'].includes(m.zone)
      const isLong = ['life', 'knowledge'].includes(m.zone)
      if (!isPool && !isLong) return { ok: false, id, error: '只能对缓冲池或生�?知识区的记忆调整 pinned' }
      const quota = isPool ? aiPinQuotaPool : aiPinQuotaLong
      if (quota <= 0) {
        return { ok: false, id, error: isPool ? '缓冲池的 AI pin 配额已用完（2 次）' : '生活/知识区的 AI pin 配额已用完（2 次）' }
      }
      if (isPool) aiPinQuotaPool -= 1
      else aiPinQuotaLong -= 1
      const amount = direction === 'down' ? -0.5 : 0.5
      const pinned = store.addPin(id, amount)
      return { ok: true, id, pinned: Number(pinned ?? 0) }
    },
  })

  // 4b) 工作记忆工具（冷存子分区，文件组�?
