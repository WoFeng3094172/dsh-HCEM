function portUp(port) {
  return new Promise((resolve) => {
    const sock = createConnection({ host: '127.0.0.1', port, timeout: 800 })
    sock.once('connect', () => { sock.destroy(); resolve(true) })
    sock.once('timeout', () => { sock.destroy(); resolve(false) })
    sock.once('error', () => { resolve(false) })
  })
}


async function ensureEmbeddingService(logger) {
  // Qwen3-Embedding 鏄父椹诲熀纭€璁炬柦锛堣蹇嗗幓閲?/ 璇箟缂撳瓨 / 鎯呯华璇箟閮介潬瀹冿級锛?
  // 涓嶅啀璺熴€屾湰鍦板垎娴佸父椹汇€嶅紑鍏崇粦瀹氾細鍏虫帀鍒嗘祦锛岃蹇嗕粛鐒惰鑳芥煡鍥炴潵銆?
  try {
    if (!(await isEmbeddingUp())) {
      const r = startService('embedding', logger)
      if (r && r.ok === false) logger.warn?.('[hcem] embedding 鎷夎捣澶辫触: ' + String(r.error || ''))
    }
  } catch (error) {
    logger.warn?.('[hcem] embedding 鎷夎捣寮傚父: ' + String((error && error.message) || error))
  }
  for (let i = 0; i < 40; i += 1) {
    if (await isEmbeddingUp()) return true
    await new Promise((resolve) => setTimeout(resolve, 500))
  }
  logger.warn?.('[hcem] Qwen3-Embedding (8094) 鏈氨缁紝鎯呯华鍒嗘瀽灏嗗洖閫€鍏抽敭璇?)
  return false
}

