              properties: {
                name: { type: 'string' },
                chars: { type: 'number' },
                updatedAt: { type: 'string' },
              },
              required: ['name', 'chars', 'updatedAt'],
            },
          },
        },
        required: ['ok', 'entries'],
      },
      render: (_args, value) => [
        {
          type: 'text',
          text:
            value.entries.length === 0
              ? '杩樻病鏈夊伐浣滅瑪璁般€?
              : value.entries.map((e) => `- ${e.name}锛?{e.chars} 瀛楋紝${e.updatedAt.slice(0, 10)}锛塦).join('\n'),
        },
      ],
    },
    execute: gateTool(async () => ({ ok: true, entries: listWork() })),
  })

  defineTool({
    name: 'hcem_work_read',
    description: '璇诲彇鏌愪釜宸ヤ綔绗旇鐨勫畬鏁村唴瀹广€?,
    parameters: {
      type: 'object',
      additionalProperties: false,
      properties: { name: { type: 'string', description: '宸ヤ綔绗旇鍚? } },
      required: ['name'],
    },
    output: {
      schema: {
        type: 'object',
        additionalProperties: false,
        properties: {
          ok: { type: 'boolean' },
          name: { type: 'string' },
          text: { type: 'string' },
          chars: { type: 'number' },
          error: { type: 'string' },
        },
        required: ['ok'],
      },
      render: (_args, value) =>
        value.ok
          ? [{ type: 'text', text: `宸ヤ綔绗旇銆?{value.name}銆嶏細\n${value.text}` }]
          : [{ type: 'text', text: `璇诲彇澶辫触锛?{value.error}` }],
    },
    execute: gateTool(async ({ name }) => readWork(name)),
  })

  // 4c) 瑙嗚宸ュ叿锛堟闈㈢洃鍚?+ 鐪嬪睆骞曪級
  defineTool({
    name: 'hcem_screen_look',
    description: '鐪嬪綋鍓嶅睆骞曪細鎴浘骞惰瑙嗚妯″瀷锛圦wen2-VL锛夋弿杩扮敾闈㈠唴瀹广€傜敤鎴疯銆岀湅鐪嬫垜鐨勫睆骞?鐪嬩笅杩欎釜銆嶆椂璋冪敤銆?,
    parameters: {
      type: 'object',
      additionalProperties: false,
      properties: {
        prompt: { type: 'string', description: '鎯崇湅浠€涔堬紙鍙€夛紝榛樿鎻忚堪鐢婚潰锛? },
      },
    },
    output: {
      schema: {
        type: 'object',
        additionalProperties: false,
        properties: {
          ok: { type: 'boolean' },
          text: { type: 'string' },
          image: { type: 'string' },
          error: { type: 'string' },
        },
        required: ['ok', 'text'],
      },
      render: (_args, value) =>
        value.ok
          ? [{ type: 'text', text: value.text || '锛堢敾闈㈡弿杩颁负绌猴級' }]
          : [{ type: 'text', text: '鐪嬪睆骞曞け璐ワ細' + (value.error || '鏈煡閿欒') }],
    },
    execute: async ({ prompt }) => {
        // 浼氳瘽闂ㄧ锛氬彧鏈?HCEM 妯″紡鐨勪細璇濇墠鑳借皟鐢?
        if (!isHcemSession(currentAgent()?.session)) {
          throw new Error('闈?HCEM 浼氳瘽锛岀姝㈣皟鐢ㄦ宸ュ叿')
        }
      const r = await describeScreen({ maxWidth: 1280, prompt })
      return { ok: !r.error, text: r.text || '', image: r.image || '', error: r.error }
    },
  })

  // 寰€鎸囧畾 HCEM 浼氳瘽鍙戜竴鏉℃秷鎭紙鎮诞鐞冭緭鍏ユ璧拌繖閲岋級
  defineTool({
    name: 'hcem_send_to_session',
    description:
      '鎶婁竴鏉＄敤鎴锋秷鎭€佽繘鎸囧畾鐨?HCEM 浼氳瘽锛堢敤浜庢偓娴悆杈撳叆妗嗭級銆俿essionId 涓嶄紶灏辩敤褰撳墠浼氳瘽銆?,
    parameters: {
      type: 'object',
      additionalProperties: false,
      properties: {
        sessionId: { type: 'string', description: '鐩爣浼氳瘽 id锛堜笉浼?褰撳墠浼氳瘽锛? },
        text: { type: 'string', description: '瑕佸彂閫佺殑鏂囨湰' },
      },
      required: ['text'],
    },
    output: {
      schema: {
        type: 'object',
        additionalProperties: false,
        properties: {
          ok: { type: 'boolean' },
          via: { type: 'string' },
          error: { type: 'string' },
        },
        required: ['ok'],
      },
      render: (_args, v) =>
        v.ok ? [{ type: 'text', text: '宸插彂閫侊紙' + (v.via || '?') + '锛? }] : [{ type: 'text', text: '鍙戦€佸け璐ワ細' + (v.error || '') }],
    },
    execute: gateTool(async ({ sessionId, text }) => {
      const target = sessionId || currentAgent()?.session?.id
      if (!target) return { ok: false, error: '娌℃湁鐩爣浼氳瘽' }
      return await sendToSession(target, String(text))
    }),
  })

  // 瑙嗗惉璁板繂鎶㈡晳锛氬埌鏈熷墠鐢?AI 鍐冲畾鏁戜笉鏁戯紙涔熷彲鏌ョ敤鎴峰湪鐪嬭棰戞椂鐨勮瘎浠凤級
  defineTool({
    name: 'hcem_memory_rescue',
    description:'瑙嗗惉璁板繂鎶㈡晳涓庣敤鎴疯瘎浠枫€俛ction=list 鍒楀嚭蹇埌鏈熶笖浠峰€间笉澶熺殑瑙嗗惉璁板繂锛沘ction=rescue 鏁戞煇涓€鏉★紙+0.4 鍠滃ソ搴﹀苟寤跺 30 澶╋級锛沘ction=rate 鎶婄敤鎴峰褰撳墠瑙嗛鐨勮瘎浠疯鎴愬垎鏁帮紙鏄庣‘璇村枩娆⑩啋like锛岃涓€鑸啋normal锛岃涓嶅枩娆⑩啋dislike锛涚敤鎴锋病璇勪环灏变笉瑕佽皟鐢紝瑙嗕负寮冩潈锛夈€俽ate 涓嶄紶 id 鏃惰嚜鍔ㄤ綔鐢ㄤ簬鏈€杩?30 鍒嗛挓鍐呯殑瑙嗛璁板繂銆?,
    parameters: {
      type: 'object',
      additionalProperties: false,
      properties: {
        action: { type: 'string', enum: ['list', 'rescue', 'rate'] },
        id: { type: 'string', description: 'rescue / rate 鏃剁殑璁板繂 id' },
        rating: { type: 'string', enum: ['like', 'normal', 'dislike'], description: 'rate 鏃剁殑鐢ㄦ埛璇勪环' },
        reason: { type: 'string', description: 'rescue 鏃剁殑鐞嗙敱' },
      },
      required: ['action'],
    },
    output: {
      schema: {
        type: 'object',
        additionalProperties: false,
        properties: {
          ok: { type: 'boolean' },
          items: { type: 'array', items: { type: 'object' } },
          p0: { type: 'number' },
          error: { type: 'string' },
        },
        required: ['ok'],
      },
      render: (_args, value) => {
        if (!value.ok) return [{ type: 'text', text: '澶辫触锛? + (value.error || '鏈煡') }]
        if (Array.isArray(value.items)) {
          if (value.items.length === 0) return [{ type: 'text', text: '娌℃湁闇€瑕佹姠鏁戠殑璁板繂銆? }]
          const lines = value.items.map(
            (m, i) => `${i + 1}. [${m.leftHours ?? '?'}h 鍚庡埌鏈焆 ${m.summary}锛堝枩濂?${m.p0}锛屼俊鎭噺 ${m.delta0}锛塦,
          )
          return [{ type: 'text', text: '寰呮姠鏁戠殑璁板繂锛歕n' + lines.join('\n') }]
        }
        return [{ type: 'text', text: `宸插鐞嗭紝褰撳墠鍠滃ソ搴?${value.p0 ?? '?'}` }]
      },
    },
    execute: async ({ action, id, rating, reason }) => {
      if (!isHcemSession(currentAgent()?.session)) return { ok: false, error: '闈?HCEM 浼氳瘽' }
      try {
        if (action === 'list') {
          return { ok: true, items: listRescueCandidates(store, { limit: 20 }) }
        }
        if (action === 'rescue') {
          const r = rescueMemory(store, id, { by: 'ai', reason })
          return { ok: r.ok, p0: r.p0, error: r.error }
        }
        if (action === 'rate') {
          const r = rateWhileWatching(store, id, rating || 'normal')
          return { ok: r.ok, p0: r.p0, error: r.error }
        }
        return { ok: false, error: '鏈煡 action' }
      } catch (e) {
        return { ok: false, error: String((e && e.message) || e) }
      }
    },
  })

  defineTool({
    name: 'hcem_video_storyboard',
    description: '鍒嗘瀽涓€涓棰戞枃浠讹細闀滃ご鍒囧垎 + 浠ｈ〃甯х綉鏍硷紝骞惰瑙嗚妯″瀷姒傛嫭鍐呭锛堥渶瑕?ffmpeg/ffprobe锛夈€?,
    parameters: {
      type: 'object',
      additionalProperties: false,
      properties: {
        videoPath: { type: 'string', description: '瑙嗛鏂囦欢缁濆璺緞' },
        maxCells: { type: 'number', description: '鐩爣鏍兼暟锛?-16锛岄粯璁?9锛屽嵆涔濆鏍硷級' },
        summary: { type: 'boolean', description: '鏄惁璁╄瑙夋ā鍨嬫鎷唴瀹癸紙榛樿 true锛? },
      },
      required: ['videoPath'],
    },
    output: {
      schema: {
        type: 'object',
        additionalProperties: false,
        properties: {
          ok: { type: 'boolean' },
          duration: { type: 'number' },
          segments: { type: 'number' },
          cuts: { type: 'number' },
          cells: { type: 'number' },
          summary: { type: 'string' },
          frames: { type: 'number' },
          error: { type: 'string' },
        },
        required: ['ok'],
      },
      render: (_args, value) =>
        value.ok
          ? [
              {
                type: 'text',
                text:
                  `瑙嗛 ${value.duration?.toFixed(1)}s锛?{value.segments} 娈点€?{value.cuts} 涓垏鐐广€?{value.cells} 涓唬琛ㄥ抚` +
                  (value.summary ? `\n\n${value.summary}` : ''),
              },
            ]
          : [{ type: 'text', text: '鍒嗘瀽澶辫触锛? + (value.error || '鏈煡閿欒') }],
    },
    execute: async ({ videoPath, maxCells, summary = true }) => {
        // 浼氳瘽闂ㄧ锛氬彧鏈?HCEM 妯″紡鐨勪細璇濇墠鑳借皟鐢?
        if (!isHcemSession(currentAgent()?.session)) {
          throw new Error('闈?HCEM 浼氳瘽锛岀姝㈣皟鐢ㄦ宸ュ叿')
        }
      const safe = safeVideoPath(videoPath)
      if (!safe.ok) return { ok: false, error: '瑙嗛璺緞涓嶅厑璁革細' + safe.error }
      // 鍙仛鍒嗛暅锛堜笉鎶藉抚銆佷笉鎻忚堪锛?
      if (!summary) {
        const r = await analyzeVideoStoryboard(safe.path, { maxCells })
        return {
          ok: r.ok,
          duration: r.duration,
          segments: r.segments,
          cuts: r.cuts,
          cells: Array.isArray(r.cells) ? r.cells.length : 0,
          error: r.error,
        }
      }
      // 鍒嗛暅 鈫?鎶藉抚 鈫?鎷煎浘 鈫?瑙嗚妯″瀷姒傛嫭
      const d = await digestVideo(safe.path, { maxCells })
      if (!d.ok) return { ok: false, error: d.error, duration: d.duration }
      return {
        ok: true,
        duration: d.duration,
        segments: d.segments,
        cuts: d.cuts,
        cells: d.frames,
        frames: d.frames,
        summary: d.summary,
      }
    },
  })
  
  // 5) 鐘舵€佸伐鍏凤紙璇荤湡瀹炲瓨鍌級
  defineTool({
    name: 'hcem_status',
    description: '鑾峰彇 HCEM 鎻掍欢褰撳墠鎯呯华鐘舵€侊紙HSL锛夈€佸瓨鍌ㄧ姸鎬佷笌鏁版嵁鐩綍銆?,
    parameters: { type: 'object', additionalProperties: false, properties: {} },
    output: {
      schema: {
        type: 'object',
        additionalProperties: false,
        properties: {
          ok: { type: 'boolean' },
          H: { type: 'number' },
          S: { type: 'number' },
          L: { type: 'number' },
          store: { type: 'string' },
          dbPath: { type: 'string' },
          memoryCount: { type: 'number' },
          tools: { type: 'array', items: { type: 'string' } },
        },
        required: ['ok', 'H', 'S', 'L'],
      },
      render(args, value) {
        const hLabel = value.H === 0 ? '0掳/360掳' : `${value.H}掳`
        return [
          {
            type: 'text',
            text: `HCEM 鐘舵€侊細H=${hLabel} / S=${value.S}% / L=${value.L}% 锝?瀛樺偍锛?{value.store ?? '鏈氨缁?}锛?{value.dbPath || '-'}锛夛綔 璁板繂 ${value.memoryCount ?? 0} 鏉,
          },
        ]
      },
    },
    execute: async () => {
        // 浼氳瘽闂ㄧ锛氬彧鏈?HCEM 妯″紡鐨勪細璇濇墠鑳借皟鐢?
        if (!isHcemSession(currentAgent()?.session)) {
          throw new Error('闈?HCEM 浼氳瘽锛岀姝㈣皟鐢ㄦ宸ュ叿')
        }
      const saved = store ? store.getEmotion('global') : null
      const memories = store ? store.listMemories({ limit: 1000 }) : []
      // 褰撳墠杩欎釜 agent 瀹為檯鑳界湅鍒扮殑宸ュ叿鍚嶃€?
      // 鐢ㄦ潵鍥炵瓟銆孒CEM 鍒板簳鏈夋病鏈夋寕涓?DSH 鍘熺敓宸ュ叿銆嶁€斺€?鍒潬妯″瀷鑷堪锛岀湅鏁版嵁銆?
      let tools = []
      try {
        const agent = currentAgent()
        const reg = agent?.ctx?.tools ?? ctx.tools
        const list = reg?.schemas?.() ?? reg?.definitions?.() ?? []
        tools = list.map((t) => t?.name).filter(Boolean).sort()
      } catch {}
      return {
        ok: true,
        H: saved ? saved.H : state.H,
        S: saved ? saved.S : state.S,
        L: saved ? saved.L : state.L,
        store: store ? 'ready' : 'unavailable',
        dbPath: store ? DB_PATH : '',
        memoryCount: memories.length,
        tools,
      }
    },
  })

  // 鈹€鈹€ 鍚堝苟鍚庣殑 9 涓伐鍏凤紙19 鈫?9锛岀渷绾?55% 宸ュ叿 token锛夆攢鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€
  // 姣忎釜鍙仛鍒嗗彂锛屽疄鐜板湪涓婇潰鐨?defineTool 閲岋紝搴曞眰 lib 涓€琛屾病鍔ㄣ€?

  // 1) 浜烘牸锛氳鑹插崱 / 鐢ㄦ埛鍗?/ me
  registerTool({
    name: 'hcem_profile',
    description:
      '浜烘牸鍗＄淮鎶ゃ€倀arget=persona 瑙掕壊鍗★紙浣犺嚜宸辩殑璁惧畾锛? user 鐢ㄦ埛鍗★紙浣犺寰楃殑鐢ㄦ埛淇℃伅锛? me 绗竴浜虹О韬唤鎽樿銆俶ode=replace 鏁存鏇挎崲銆乤ppend 杩藉姞銆乪dit 灞€閮ㄦ敼锛堢敤 find+replace锛宖ind 蹇呴』鍞竴鍖归厤锛宺eplace 涓嶅～=鍒犻櫎锛夈€?,
    parameters: {
      type: 'object',
      additionalProperties: false,
      properties: {
        target: { type: 'string', enum: ['persona', 'user', 'me'], description: '榛樿 persona' },
        mode: { type: 'string', enum: ['replace', 'append', 'edit'], description: '榛樿 replace锛沞dit 鏃剁敤 find/replace' },
        text: { type: 'string', description: '鏁存鍐呭锛坮eplace/append锛屾垨 target=me锛? },
        find: { type: 'string', description: 'mode=edit 鏃惰鏇挎崲/鍒犻櫎鐨勭墖娈? },
        replace: { type: 'string', description: 'mode=edit 鏃剁殑鏇挎崲鏂囧瓧锛涗笉濉?鍒犻櫎' },
      },
      required: ['target'],
    },
    output: SUMMARY_OUTPUT,
    execute: async ({ target = 'persona', mode = 'replace', text, find, replace }) => {
      if (target === 'me') return toSummary(await impls.hcem_me_edit.execute({ text }))
      if (mode === 'edit' || find) {
        return toSummary(
          await impls.hcem_persona_edit.execute({ find, replace, target: target === 'user' ? 'user' : 'persona' }),
        )
      }
      const impl = target === 'user' ? impls.hcem_user_card_write : impls.hcem_persona_write
      return toSummary(await impl.execute({ text, mode }))
    },
  })

  // 2) 绗旇 路 鏃ヨ
  registerTool({
    name: 'hcem_journal',
    description:
      '鏃ヨ鏈紙绉佷汉锛屼笉娉ㄥ叆鎻愮ず璇嶏級銆俛ction=list 鍒楀嚭 / read 璇诲叏鏂囷紙瑕?name锛? write 鍐欏叆锛堣 name+text锛宮ode=replace 瑕嗙洊銆乤ppend 杩藉姞锛夈€?,
    parameters: {
      type: 'object',
      additionalProperties: false,
      properties: {
        action: { type: 'string', enum: ['list', 'read', 'write'] },
        name: { type: 'string', description: '鏃ヨ鏍囬锛坮ead/write 蹇呭～锛? },
        text: { type: 'string', description: '姝ｆ枃锛坵rite 蹇呭～锛孧arkdown锛? },
        mode: { type: 'string', enum: ['replace', 'append'], description: '榛樿 replace' },
      },
      required: ['action'],
    },
    output: SUMMARY_OUTPUT,
    execute: async ({ action, name, text, mode = 'replace' }) => {
      if (action === 'list') return toSummary(await impls.hcem_journal_list.execute({}))
      if (action === 'read') return toSummary(await impls.hcem_journal_read.execute({ name }))
      return toSummary(await impls.hcem_journal_write.execute({ name, text, mode }))
    },
  })

  // 3) 绗旇 路 浜虹墿
  registerTool({
    name: 'hcem_people',
    description:
      '浜虹墿鍏崇郴缃戙€俛ction=list 鍒楀嚭 / read 璇绘煇浜哄崱鐗囷紙瑕?name锛? write 鍐欏叆锛堣 name+text锛宮ode=replace 瑕嗙洊銆乤ppend 杩藉姞锛夈€傝仈绯绘柟寮忓彧鍦ㄦ湰鏈猴紝涓嶈涓诲姩澶栨硠銆?,
    parameters: {
      type: 'object',
      additionalProperties: false,
      properties: {
        action: { type: 'string', enum: ['list', 'read', 'write'] },
        name: { type: 'string', description: '浜虹墿绉板懠锛坮ead/write 蹇呭～锛? },
        text: { type: 'string', description: '浜虹墿鍗℃鏂囷紙write 蹇呭～锛? },
        mode: { type: 'string', enum: ['replace', 'append'], description: '榛樿 replace' },
      },
      required: ['action'],
    },
    output: SUMMARY_OUTPUT,
    execute: async ({ action, name, text, mode = 'replace' }) => {
      if (action === 'list') return toSummary(await impls.hcem_people_list.execute({}))
      if (action === 'read') return toSummary(await impls.hcem_people_read.execute({ name }))
      return toSummary(await impls.hcem_people_write.execute({ name, text, mode }))
    },
  })

  // 4) 绗旇 路 宸ヤ綔锛堥粯璁ゅ叧锛岃 TOOL_MOD锛?
  registerTool({
    name: 'hcem_work',
    description:
      '宸ヤ綔绗旇銆俛ction=list 鍒楀嚭 / read 璇诲叏鏂囷紙瑕?name锛? write 璁板綍锛堣 name+text锛宮ode=append 杩藉姞銆乺eplace 瑕嗙洊锛夈€傝褰曞悗鍥炰竴鍙ャ€屾垜杩欏氨鎶婅繖浜涗簨璁板叆鎴戠殑宸ヤ綔绗旇閲屻€嶃€?,
    parameters: {
      type: 'object',
      additionalProperties: false,
      properties: {
        action: { type: 'string', enum: ['list', 'read', 'write'] },
        name: { type: 'string', description: '绗旇鍚嶏紙read/write 蹇呭～锛? },
        text: { type: 'string', description: '姝ｆ枃锛坵rite 蹇呭～锛? },
        mode: { type: 'string', enum: ['replace', 'append'], description: '榛樿 append' },
      },
      required: ['action'],
    },
    output: SUMMARY_OUTPUT,
    execute: async ({ action, name, text, mode = 'append' }) => {
      if (action === 'list') return toSummary(await impls.hcem_work_list.execute({}))
      if (action === 'read') return toSummary(await impls.hcem_work_read.execute({ name }))
      return toSummary(await impls.hcem_work_write.execute({ name, text, mode }))
    },
  })

  // 5) 璁板繂 路 閲嶈搴?
  registerTool({
    name: 'hcem_memory',
    description: '璋冩暣涓€鏉¤蹇嗙殑閲嶈搴︼紙pinned锛夛細direction=up 鍔?0.5銆乨own 鍑?0.5锛坧inned 鑼冨洿 0~2锛岀紦鍐叉睜 0~1锛夈€?,
    parameters: {
      type: 'object',
      additionalProperties: false,
      properties: {
        id: { type: 'string', description: '璁板繂 id' },
        direction: { type: 'string', enum: ['up', 'down'], description: '榛樿 up' },
      },
      required: ['id'],
    },
    output: SUMMARY_OUTPUT,
    execute: async ({ id, direction = 'up' }) => toSummary(await impls.hcem_memory_pin.execute({ id, direction })),
  })

  // 6) 鐘舵€?
  registerTool({
    name: 'hcem_status',
    description: 'HCEM 褰撳墠鐘舵€侊細HSL 鎯呯华銆佸瓨鍌ㄦ槸鍚﹀氨缁€佽蹇嗘潯鏁般€佹暟鎹洰褰曘€?,
    parameters: { type: 'object', additionalProperties: false, properties: {} },
    output: SUMMARY_OUTPUT,
    execute: async () => toSummary(await impls.hcem_status.execute({})),
  })

  // 7) 瑙嗗惉 路 鐪嬶紙灞忓箷 / 瑙嗛 / 瑙嗗惉璁板繂鎶㈡晳 / 鐩戝惉鐘舵€侊級
  registerTool({
    name: 'hcem_vision',
    description:
      '瑙嗗惉鑳藉姏銆俴ind=screen 鐪嬪綋鍓嶅睆骞曪紙prompt 鍙€夛紝闂綘鎯崇湅浠€涔堬級/ video 鍒嗘瀽瑙嗛鏂囦欢锛堣 videoPath锛? rescue 瑙嗗惉璁板繂鐨勬姠鏁戜笌璇勫垎锛坅ction=list|rescue|rate锛宺ate 鏃?rating=like|normal|dislike锛? status 鏌ヨ妗岄潰鐩戝惉鐘舵€併€?,
    parameters: {
      type: 'object',
      additionalProperties: false,
      properties: {
        kind: { type: 'string', enum: ['screen', 'video', 'rescue', 'status'] },
        prompt: { type: 'string', description: 'kind=screen 鏃舵兂鐪嬩粈涔? },
        videoPath: { type: 'string', description: 'kind=video 鏃剁殑瑙嗛鏂囦欢璺緞' },
        maxCells: { type: 'number', description: 'kind=video 鐨勫垎闀滄牸鏁帮紙4-16锛? },
        summary: { type: 'boolean', description: 'kind=video 鏄惁璁╄瑙夋ā鍨嬫鎷? },
        action: { type: 'string', enum: ['list', 'rescue', 'rate'], description: 'kind=rescue 鏃剁殑鍔ㄤ綔' },
        id: { type: 'string', description: 'kind=rescue 鏃剁殑璁板繂 id' },
        rating: { type: 'string', enum: ['like', 'normal', 'dislike'], description: 'kind=rescue銆乤ction=rate 鏃剁殑璇勪环' },
        reason: { type: 'string', description: 'kind=rescue銆乤ction=rescue 鏃剁殑鐞嗙敱' },
      },
      required: ['kind'],
    },
    output: SUMMARY_OUTPUT,
    execute: async ({ kind, prompt, videoPath, maxCells, summary, action, id, rating, reason }) => {
      if (kind === 'screen') return toSummary(await impls.hcem_screen_look.execute({ prompt }))
      if (kind === 'video') return toSummary(await impls.hcem_video_storyboard.execute({ videoPath, maxCells, summary }))
      if (kind === 'status') {
        // screen_status 浠ュ墠鍙湪鎻愮ず璇嶉噷鍑虹幇杩囥€佹病娉ㄥ唽杩囷紱杩欓噷灏卞湴瀹炵幇
        const s = loadSettings(SETTINGS_PATH)
        const on = s.listening === true
        const age = lastScreenAt ? Math.round((Date.now() - lastScreenAt) / 1000) : -1
        const bits = [`妗岄潰鐩戝惉锛?{on ? '寮€鍚? : '鍏抽棴'}`]
        bits.push(age >= 0 ? `鏈€杩戠敾闈細${age} 绉掑墠` : '鏈€杩戠敾闈細鏃?)
        if (lastScreenDesc) bits.push('鐢婚潰鎻忚堪锛? + String(lastScreenDesc).slice(0, 100))
        return { ok: true, summary: bits.join('锝?) }
      }
      return toSummary(await impls.hcem_memory_rescue.execute({ action, id, rating, reason }))
    },
  })

  // 8) 瑙嗗惉 路 鍚紙鏂板锛氫富鍔ㄥ綍涓€娈靛苟鍒嗘瀽锛?
  registerTool({
    name: 'hcem_listen',
    description:
      '涓诲姩鍚竴涓嬪懆鍥达細褰曚竴灏忔锛堥粯璁?5 绉掞紝鏈€澶?15 绉掞級锛岃繑鍥炶浆鍐欐枃鏈?+ 澹伴煶鍒嗙被銆? +
      'mode=music 鏃舵敼涓哄綍闊充箰鍒嗘瀽锛圔PM/璋冩€?鍜屽鸡/娈佃惤锛夛紝姝ゆ椂绉掓暟鍙粰鍒?10~60锛岃秺闀胯秺鍑嗭紙榛樿 20锛夈€? +
      'audioPath 缁欎簡灏卞彧鍒嗘瀽閭ｄ釜闊抽/瑙嗛鏂囦欢銆佷笉褰曢煶锛堣棰戜細鑷姩鎶介煶杞級銆? +
      'videoPath 鏄?audioPath 鐨勫悓涔夊啓娉曪紝涓撶粰瑙嗛鐢ㄣ€?,
    parameters: {
      type: 'object',
      additionalProperties: false,
      properties: {
        seconds: { type: 'number', description: '褰曢煶鏃堕暱锛歷oice 妯″紡 1-15锛堥粯璁?5锛夛紱music 妯″紡 10-60锛堥粯璁?20锛? },
        mode: { type: 'string', enum: ['voice', 'music'], description: 'voice=杞啓鍒嗙被锛堥粯璁わ級锛沵usic=闊充箰鍒嗘瀽' },
        audioPath: { type: 'string', description: '瑕佸垎鏋愮殑闊抽/瑙嗛鏂囦欢璺緞锛堢粰浜嗗氨涓嶅綍闊筹級' },
        videoPath: { type: 'string', description: '瑙嗛鏂囦欢璺緞锛堢瓑浠?audioPath锛屼細鎶介煶杞ㄥ啀璇嗗埆锛? },
      },
    },
    output: SUMMARY_OUTPUT,
    execute: async ({ seconds, mode, audioPath, videoPath } = {}) => {
      const s = Math.max(1, Math.min(15, Number(seconds) || 5))
      const wantMusic = mode === 'music'
      const filePath = videoPath || audioPath
      try {
        // 缁欏畾浜嗘枃浠讹細涓嶅綍闊筹紝鐩存帴鍒嗘瀽
        if (filePath) {
          const isVideo = /\.(mp4|mkv|mov|avi|webm|flv|m4v|ts|wmv)$/i.test(String(filePath))
          let target = String(filePath)
          // 瑙嗛鍏堟娊闊宠建锛歠fmpeg 鈫?16k 鍗曞０閬?wav锛屽悗闈?ASR/闊充箰鍒嗘瀽閮借兘鍚?
          if (isVideo) {
            const outWav = join(DATA_DIR, 'audio', `video-${Date.now()}.wav`)
            mkdirSync(join(DATA_DIR, 'audio'), { recursive: true })
            target = await extractAudioFromVideo(String(filePath), outWav)
          }
          // 闊充箰鍒嗘瀽锛堝惈鎯呮劅锛?
          if (wantMusic) {
            const m = await analyzeMusicDeep(target)
            if (!m.ok) return { ok: false, summary: '闊充箰鍒嗘瀽澶辫触锛? + String(m.error || '') }
            return { ok: true, summary: (isVideo ? '宸叉娊闊宠建銆? : '') + m.text }
          }
          // 浜哄０璇嗗埆锛歈wen3-ASR锛堣嚜甯?VAD 鍒嗘锛岃 lib/audio/asr.mjs锛?
          const asr = await transcribe(target)
          if (!asr.ok) return { ok: false, summary: '璇嗗埆澶辫触锛? + String(asr.error || '') }
          const parts = []
          if (isVideo) parts.push('宸蹭粠瑙嗛鎶藉嚭闊宠建')
          const text = String(asr.text || '').trim()
          parts.push(text ? '鍚埌锛? + text.slice(0, 800) : '锛堟病鏈夎瘑鍒埌浜哄０锛?)
          // 椤烘墜甯︿竴浠介煶涔愬垎鏋愶紝瑙嗛閲屽父鏈夐厤涔?
          try {
            const info = await analyzeMusic(target, { maxSeconds: 60 })
            if (info.ok && info.kind !== 'speech' && info.text) parts.push('闊充箰锛? + info.text)
          } catch {}
          return { ok: true, summary: parts.join('\n') }
        }
        // 闊充箰妯″紡锛氬崟鐙綍涓€娈甸暱鐨勫啀鍋氬垎鏋愩€?
        // 涓嶈蛋 audioTick 鈥斺€?閭ｅ杩樿璺?ASR/鎯呯华/PANNs锛岃 60 绉掞紱
        // 鑰岄煶涔愬垎鏋愰渶瑕佺殑鏄暱搴︼紝涓嶆槸鏇村妯″瀷銆?
        if (wantMusic) {
          const seconds2 = Math.max(10, Math.min(60, Number(seconds) || 20))
          const m = await recordAndAnalyzeMusic({ dataDir: DATA_DIR, seconds: seconds2 })
          if (!m.ok) return { ok: false, summary: '闊充箰鍒嗘瀽澶辫触锛? + String(m.error || '') }
          return { ok: true, summary: `褰曚簡 ${m.seconds} 绉掋€?{m.text}` }
        }
        const r = await audioTick({ dataDir: DATA_DIR, seconds: s })
        const parts = []
        if (r?.kind || r?.categoryName) parts.push('鍦烘櫙锛? + String(r.categoryName || r.kind))
        if (r?.text) parts.push('鍚埌锛? + String(r.text).slice(0, 500))
        if (r?.soundDesc) parts.push(String(r.soundDesc).slice(0, 300))
        // 鎰熺煡灞傚悗鍙拌窇杩囩殑闊充箰娣卞垎鏋愶紝椤烘墜甯︿笂锛堝彲鑳芥潵鑷渶杩戝嚑鍒嗛挓锛?
        const info = r?.musicInfo
        if (info?.ok) parts.push('闊充箰锛? + info.text)
        return { ok: r?.ok !== false, summary: parts.join('\n') || '锛堟病鍚埌鏄庢樉澹伴煶锛? }
      } catch (error) {
        return { ok: false, summary: '褰曢煶澶辫触锛? + String((error && error.message) || error) }
      }
    },
  })

  // 9) 璇达紙鍙戞秷鎭?/ TTS锛?
  registerTool({
    name: 'hcem_voice',
    description:
      '璇磋瘽 / 閫氳瘽銆俛ction=speak 鐢?TTS 璇翠竴鍙ワ紙瑕?text锛屾部鐢ㄥ綋鍓嶆儏缁姘旓級/ send 鎶婁竴鏉℃秷鎭€佽繘鎸囧畾 HCEM 浼氳瘽锛堣 text锛宻essionId 涓嶅～=褰撳墠浼氳瘽锛? +
      '/ call_start 寮€濮嬭闊抽€氳瘽锛堜竴鐩村惉锛屽惉鍒板氨绛旓紝鐢ㄦ埛寮€鍙ｄ細鎵撴柇鎾姤锛? call_stop 鎸傛柇 / call_status 鏌ラ€氳瘽鐘舵€併€?,
    parameters: {
      type: 'object',
      additionalProperties: false,
      properties: {
        action: { type: 'string', enum: ['speak', 'send', 'call_start', 'call_stop', 'call_status'] },
        text: { type: 'string', description: '瑕佽/鍙戠殑鍐呭' },
        sessionId: { type: 'string', description: 'action=send 鐨勭洰鏍囦細璇濓紙鍙€夛級' },
      },
      required: ['action'],
    },
    output: SUMMARY_OUTPUT,
    execute: async ({ action, text, sessionId }) => {
      if (action === 'send') return toSummary(await impls.hcem_send_to_session.execute({ sessionId, text }))
      if (action === 'call_status') {
        const s = voiceCall ? voiceCall.status() : { active: false, speaking: false, iterations: 0, bargesIn: 0 }
        return { ok: true, summary: s.active ? `閫氳瘽涓紙宸插惉 ${s.iterations} 鍙ワ紝鎵撴柇 ${s.bargesIn} 娆?{s.speaking ? '锛屾鍦ㄨ璇? : ''}锛塦 : '娌℃湁鍦ㄩ€氳瘽' }
      }
      if (action === 'call_start') {
        const c = ensureVoiceCall()
        const r = c.start()
        return { ok: r.ok !== false, summary: r.already ? '閫氳瘽宸茬粡鍦ㄨ繘琛? : '閫氳瘽宸插紑濮嬶細鎴戜細涓€鐩村惉鐫€锛屼綘璇磋瘽鎴戝氨绛旓紝浣犲紑鍙ｆ垜灏卞仠銆? }
      }
      if (action === 'call_stop') {
        if (!voiceCall) return { ok: true, summary: '鏈潵灏辨病鍦ㄩ€氳瘽' }
        await voiceCall.stop()
        return { ok: true, summary: '閫氳瘽宸茬粨鏉熴€? }
      }
      try {
        const e = store?.getEmotion('global') || { H: 360, S: 15, L: 55 }
        const outPath = join(DATA_DIR, 'tts', 'say-' + Date.now() + '.wav')
        const r = await speakReply({ text: String(text || ''), H: e.H, S: e.S, L: e.L, outPath, play: true })
        return r?.ok
          ? { ok: true, summary: '宸茶锛? + String(text).slice(0, 120) }
          : { ok: false, summary: 'TTS 澶辫触锛? + String(r?.error || 'unknown') }
      } catch (error) {
        return { ok: false, summary: 'TTS 寮傚父锛? + String((error && error.message) || error) }
      }
    },
  })

  // 4) 鍏抽棴鏃舵竻鐞?
  ctx.effect(
    () => () => {
      try {
        store?.close()
      } catch {
        // ignore
      }
    },
    'hcem.store.dispose',
  )
}
