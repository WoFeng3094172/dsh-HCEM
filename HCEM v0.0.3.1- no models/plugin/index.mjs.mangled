          ? [{ type: 'text', text: `宸插啓鍏ヤ汉鐗╁崱銆?{value.name}銆嶏紙${value.chars} 瀛楋級${value.warning ? `锝?{value.warning}` : ''}` }]
          : [{ type: 'text', text: `鍐欏叆澶辫触锛?{value.error}` }],
    },
    execute: gateTool(async ({ name, text, mode = 'replace' }) => writePerson(name, text, mode)),
  })

  // 4a) 璁板繂 pin 宸ュ叿锛圓I 閰嶉锛氱紦鍐叉睜 2 娆°€佺敓娲?鐭ヨ瘑鍖?2 娆★紝鍒嗗紑璁★級
  let aiPinQuotaPool = 2
  let aiPinQuotaLong = 2
  defineTool({
    name: 'hcem_memory_pin',
    description:
      '璋冩暣璁板繂閲嶈搴︼紙pinned锛夛細direction=up 鍔?0.5锛宒own 鍑?0.5锛坧inned 鑼冨洿 0~2锛岀紦鍐叉睜 0~1锛夈€? +
      '缂撳啿姹犻厤棰?2 娆°€佺敓娲?鐭ヨ瘑鍖洪厤棰?2 娆★紙鍒嗗紑璁★紝涓嶈兘璺ㄥ尯浣跨敤锛夈€? +
      '鐢ㄦ埛鏄庣‘瑕佹眰璁颁綇鎴栦綘纭俊閲嶈鏃?up锛涗綘鍒ゆ柇鏌愭潯宸蹭笉閲嶈/杩囨椂鏃跺彲浠?down锛堝彲鎶垫秷鐢ㄦ埛鎴栬嚜宸辩殑鍒ゆ柇锛夈€? +
      '浠诲姟绫诲伐浣滆鐢?hcem_work(action=write)锛屼笉瑕侀噸澶?pin銆?,
    parameters: {
      type: 'object',
      additionalProperties: false,
      properties: {
        id: { type: 'string', description: '璁板繂 id' },
        direction: { type: 'string', enum: ['up', 'down'], description: 'up=鍔?0.5锛宒own=鍑?0.5锛涢粯璁?up' },
      },
      required: ['id'],
    },
    output: {
      schema: {
        type: 'object',
        additionalProperties: false,
        properties: {
          ok: { type: 'boolean' },
          id: { type: 'string' },
          pinned: { type: 'number' },
          error: { type: 'string' },
        },
        required: ['ok'],
      },
      render: (_args, value) =>
        value.ok
          ? [{ type: 'text', text: `宸茶皟鏁淬€?{value.id}銆峱inned=${value.pinned}锛堢紦鍐叉睜鍓╀綑 ${aiPinQuotaPool} 娆?/ 鐢熸椿鐭ヨ瘑鍖哄墿浣?${aiPinQuotaLong} 娆★級` }]
          : [{ type: 'text', text: `pin 澶辫触锛?{value.error}` }],
    },
    execute: async ({ id, direction = 'up' }) => {
        // 浼氳瘽闂ㄧ锛氬彧鏈?HCEM 妯″紡鐨勪細璇濇墠鑳借皟鐢?
        if (!isHcemSession(currentAgent()?.session)) {
          throw new Error('闈?HCEM 浼氳瘽锛岀姝㈣皟鐢ㄦ宸ュ叿')
        }
      const m = store ? store.getMemory(id) : null
      if (!m) return { ok: false, id, error: 'not-found' }
      const isPool = ['context', 'pool_fast', 'pool_observe', 'pool_keep'].includes(m.zone)
      const isLong = ['life', 'knowledge'].includes(m.zone)
      if (!isPool && !isLong) return { ok: false, id, error: '鍙兘瀵圭紦鍐叉睜鎴栫敓娲?鐭ヨ瘑鍖虹殑璁板繂璋冩暣 pinned' }
      const quota = isPool ? aiPinQuotaPool : aiPinQuotaLong
      if (quota <= 0) {
        return { ok: false, id, error: isPool ? '缂撳啿姹犵殑 AI pin 閰嶉宸茬敤瀹岋紙2 娆★級' : '鐢熸椿/鐭ヨ瘑鍖虹殑 AI pin 閰嶉宸茬敤瀹岋紙2 娆★級' }
      }
      if (isPool) aiPinQuotaPool -= 1
      else aiPinQuotaLong -= 1
      const amount = direction === 'down' ? -0.5 : 0.5
      const pinned = store.addPin(id, amount)
      return { ok: true, id, pinned: Number(pinned ?? 0) }
    },
  })

  // 4b) 宸ヤ綔璁板繂宸ュ叿锛堝喎瀛樺瓙鍒嗗尯锛屾枃浠剁粍锛?
  defineTool({
    name: 'hcem_work_write',
    description:
      '鎶婄敤鎴蜂氦浠ｇ殑宸ヤ綔璁板叆宸ヤ綔璁板繂锛堟枃浠剁粍锛屼笉鍘嬬缉锛夈€傝褰曞悗璇峰洖澶嶃€屾垜杩欏氨鎶婅繖浜涗簨璁板叆鎴戠殑宸ヤ綔绗旇閲屻€嶃€俶ode=append 杩藉姞锛宺eplace 瑕嗙洊銆?,
    parameters: {
      type: 'object',
      additionalProperties: false,
      properties: {
        name: { type: 'string', description: '宸ヤ綔绗旇鍚嶏紝濡?璁烘枃鍐欎綔 / 缃戠珯寮€鍙? },
        text: { type: 'string', description: '宸ヤ綔鍐呭锛圡arkdown锛? },
        mode: { type: 'string', enum: ['append', 'replace'], description: '榛樿 append' },
      },
      required: ['name', 'text'],
    },
    output: {
      schema: {
        type: 'object',
        additionalProperties: false,
        properties: {
          ok: { type: 'boolean' },
          name: { type: 'string' },
          chars: { type: 'number' },
          usage: {
            type: 'object',
            additionalProperties: false,
            properties: {
              chars: { type: 'number' },
              max: { type: 'number' },
              ratio: { type: 'number' },
            },
            required: ['chars', 'max', 'ratio'],
          },
          warning: { type: 'string' },
          error: { type: 'string' },
        },
        required: ['ok'],
      },
      render: (_args, value) =>
        value.ok
          ? [
              {
                type: 'text',
                text: `宸茶鍏ュ伐浣滅瑪璁般€?{value.name}銆嶏紙${value.chars} 瀛楋紝鎬诲崰鐢?${Math.round((value.usage?.ratio ?? 0) * 100)}%锛?{value.warning ? `锝?{value.warning}` : ''}`,
              },
            ]
          : [{ type: 'text', text: `鍐欏叆澶辫触锛?{value.error}` }],
    },
    execute: gateTool(async ({ name, text, mode = 'append' }) => writeWork(name, text, mode)),
  })

  defineTool({
    name: 'hcem_work_list',
    description: '鍒楀嚭鎵€鏈夊伐浣滅瑪璁帮紙鏂囦欢鍚嶃€佸瓧鏁般€佹洿鏂版椂闂达級銆?,
    parameters: { type: 'object', additionalProperties: false, properties: {} },
    output: {
